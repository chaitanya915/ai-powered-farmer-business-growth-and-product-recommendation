```gitignore
# ==============================
# Python
# ==============================

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.egg-info/
dist/
build/

# ==============================
# Environment Variables
# ==============================

.env
.env.*
!.env.example

# ==============================
# Node / React
# ==============================

node_modules/
frontend/node_modules/

frontend/dist/
frontend/build/

.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================
# PostgreSQL / Database
# ==============================

*.sql.backup
*.dump

# ==============================
# Machine Learning
# ==============================

ml/models/*
ml/artifacts/*

# Keep directory structure
!ml/models/.gitkeep
!ml/artifacts/.gitkeep

*.h5
*.keras
*.pkl
*.joblib
*.onnx

# ==============================
# Data
# ==============================

data/raw/*
data/processed/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# ==============================
# Generated Reports
# ==============================

reports/generated/*

!reports/generated/.gitkeep

# ==============================
# IDE
# ==============================

.vscode/
.idea/

# ==============================
# Operating System
# ==============================

.DS_Store
Thumbs.db
desktop.ini

# ==============================
# Logs
# ==============================

*.log
logs/

# ==============================
# Coverage
# ==============================

.coverage
htmlcov/
coverage.xml

# ==============================
# Temporary Files
# ==============================

*.tmp
*.temp
*.swp
*.swo
```
