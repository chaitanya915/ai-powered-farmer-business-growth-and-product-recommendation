*.egg-info/
build/
dist/

# Environment variables
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

frontend/node_modules/
frontend/dist/
frontend/build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Database
*.sql.backup
*.dump

# Machine learning model artifacts
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.onnx

# Generated reports
reports/generated/

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
