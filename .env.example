```env
# =====================================
# Application
# =====================================

APP_NAME=AI-Powered Farmer Business Growth
APP_ENV=development
DEBUG=true

# =====================================
# Backend
# =====================================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# =====================================
# Database
# =====================================

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/farmer_business_db

# =====================================
# Authentication
# =====================================

JWT_SECRET_KEY=CHANGE_THIS_IN_LOCAL_ENVIRONMENT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================
# Frontend
# =====================================

VITE_API_BASE_URL=http://localhost:8000/api

# =====================================
# AI / LLM
# =====================================

LLM_API_KEY=CHANGE_THIS_IN_LOCAL_ENVIRONMENT

# =====================================
# Application Security
# =====================================

CORS_ORIGINS=http://localhost:5173
```
